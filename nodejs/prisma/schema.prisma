generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Performance {
  id        Int      @id @default(autoincrement())
  name      String
  venue     String
  eventDate DateTime
  capacity  Int
  basePrice Float
  /// SCHEDULED | ON_SALE | SOLD_OUT | CANCELLED | COMPLETED — see src/statuses.js
  status    String   @default("SCHEDULED")
  tickets   Ticket[]
}

model Order {
  id               Int      @id @default(autoincrement())
  customerName     String
  customerEmail    String
  /// PENDING | CONFIRMED | CANCELLED | REFUNDED — see src/statuses.js
  status           String   @default("PENDING")
  totalAmount      Float?
  paymentReference String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tickets          Ticket[]
}

model Ticket {
  id            Int           @id @default(autoincrement())
  orderId       Int
  performanceId Int
  section       String
  seatRow       String?
  seatNumber    Int?
  price         Float
  /// VALID | USED | CANCELLED | EXPIRED — see src/statuses.js
  status        String        @default("VALID")
  order         Order         @relation(fields: [orderId], references: [id])
  performance   Performance   @relation(fields: [performanceId], references: [id])
  scanAttempts  ScanAttempt[]
}

/// One presentation of a ticket at a door, admitted or turned away.
model ScanAttempt {
  id        Int      @id @default(autoincrement())
  /// Nullable so a presentation that resolves to no ticket can still be recorded.
  ticketId  Int?
  /// Free text: the vocabulary of outcomes is a design decision.
  result    String
  scannedBy String?
  scannedAt DateTime @default(now())
  ticket    Ticket?  @relation(fields: [ticketId], references: [id])
}
