#!/bin/sh
# Maven Wrapper script
# Downloads Maven if not present and runs it

set -e

MAVEN_HOME="${HOME}/.m2/wrapper/dists/apache-maven-3.9.6"
MAVEN_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.6/apache-maven-3.9.6-bin.tar.gz"

if [ ! -f "${MAVEN_HOME}/bin/mvn" ]; then
    echo "Downloading Maven 3.9.6..."
    mkdir -p "${MAVEN_HOME}"
    if command -v curl > /dev/null 2>&1; then
        curl -fsSL "${MAVEN_URL}" | tar xz -C "${MAVEN_HOME}" --strip-components=1
    elif command -v wget > /dev/null 2>&1; then
        wget -qO- "${MAVEN_URL}" | tar xz -C "${MAVEN_HOME}" --strip-components=1
    else
        echo "Error: curl or wget required" >&2
        exit 1
    fi
fi

exec "${MAVEN_HOME}/bin/mvn" "$@"
